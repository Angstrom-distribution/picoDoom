ifeq ($(V),1)
	VB=''
else
	VB=@
endif


CFLAGS ?= -O2

# Needed whatever CFLAGS the caller passes.
WAYLAND_CFLAGS := -Wall -DNORMALUNIX -DLINUX -D_DEFAULT_SOURCE
WAYLAND_CFLAGS += -DCMAP256 -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200
LIBS+=-lm

PKG_CONFIG ?= pkg-config
WAYLAND_SCANNER ?= wayland-scanner
ifeq ($(origin WAYLAND_PROTOCOLS_DIR),undefined)
WAYLAND_PROTOCOLS_DIR := $(shell $(PKG_CONFIG) --variable=pkgdatadir wayland-protocols)
endif

WAYLAND_CFLAGS += $(shell $(PKG_CONFIG) --cflags wayland-client)
ifeq ($(STATIC),1)
LDFLAGS+=-static
LIBS+=$(shell $(PKG_CONFIG) --static --libs wayland-client)
else
LIBS+=$(shell $(PKG_CONFIG) --libs wayland-client)
endif

# subdirectory for objects, apart from the other platforms because of CMAP256
OBJDIR=build-wayland
OUTPUT=doomgeneric

WAYLAND_CFLAGS += -I$(OBJDIR)

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_wayland.o xdg-shell-protocol.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

.PHONY: all clean print

all:	 $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT)

$(OUTPUT):	$(OBJS)
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(WAYLAND_CFLAGS) $(LDFLAGS) $(OBJS) \
	-o $(OUTPUT) $(LIBS)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/xdg-shell-client-protocol.h: $(WAYLAND_PROTOCOLS_DIR)/stable/xdg-shell/xdg-shell.xml | $(OBJDIR)
	@echo [Generating $@]
	$(VB)$(WAYLAND_SCANNER) client-header $< $@

$(OBJDIR)/xdg-shell-protocol.c: $(WAYLAND_PROTOCOLS_DIR)/stable/xdg-shell/xdg-shell.xml | $(OBJDIR)
	@echo [Generating $@]
	$(VB)$(WAYLAND_SCANNER) private-code $< $@

$(OBJDIR)/%-protocol.o: $(OBJDIR)/%-protocol.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) $(WAYLAND_CFLAGS) -c $< -o $@

$(OBJDIR)/doomgeneric_wayland.o: doomgeneric_wayland.c $(OBJDIR)/xdg-shell-client-protocol.h
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) $(WAYLAND_CFLAGS) -c $< -o $@

$(OBJDIR)/%.o:	%.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) $(WAYLAND_CFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)
